+    tick(0);       /* freeze expired, error inside the deadband: the integration path ABANDONS the slew; I stays 0 */
+    REQUIRE_5F_DELTA(g_slew_abandoned, s5f_aband, "(v) freeze-expiry abandon");
+    tick(-3000);   /* (vi) crossing at I=0 with last-cross sample 0: midpoint == I -> NOTHING armed */
+    REQUIRE_5F_DELTA(g_slew_noarm, s5f_noarm, "(vi) midpoint==I no-arm");
+    for (int k = 0; k < 10; k++) tick(-3000); /* freeze at I=0 */
+    /* (vii) recompute mid-slew */
+    g_context = "slew-walk-rearm";
+    set_constants(2000, 25000, 0, 200);
+    reset_state();
+    for (int k = 0; k < GATE_HOLDOFF_DRV + 60; k++) tick(3000);  /* reopen, back to the full-rail equilibrium */
+    tick(-3000);                          /* stale crossing arms a slew (still active after its own tick) */
+#ifdef PRODUCT_NAME_M17
+    if (!integral_gate_slew_active)
