+#define REQUIRE_5F_DELTA(counter, before, what)
+#define SNAP_5F()
+#endif
+    for (int k = 0; k < GATE_HOLDOFF_DRV + 60; k++) tick(3000);  /* open the gate, wind I to the full-authority
