+    for (int k = 0; k < 50; k++) tick(-5000);                       /* 50 ticks into the freeze */
+    set_constants(2000, 25, 0, 200);                                /* recompute mid-freeze: full re-arm */
+    for (int k = 0; k < 200; k++) tick(-5000);                      /* freeze is gone: integration resumes immediately */
+    tick(5000);                                                     /* first flip after re-arm: stale (never-crossed) again */
+    for (int k = 0; k < 200; k++) tick(5000);
