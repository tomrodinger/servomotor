+#endif
+    set_constants(2000, 25000, 0, 200);   /* recompute MID-SLEW: slew target/dir/active must all clear (checked in set_constants) */
+    for (int k = 0; k < 50; k++) tick(-3000);  /* no freeze after re-arm: integration resumes immediately */
+    tick(3000);                           /* first flip after re-arm: never-crossed stale crossing again */
+    for (int k = 0; k < 50; k++) tick(3000);
