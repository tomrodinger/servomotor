+        coverage_failed = 1;
+    }
+    if (!g_slew_armed || !g_slew_rearm || !g_slew_noarm || !g_slew_steps ||
+        !g_slew_completed || !g_slew_passed || !g_slew_abandoned || !g_slew_unwind) {
+        fprintf(stderr, "SLEW COVERAGE FAILED: the fw 0.15.4.2 crossing-correction slew "
