-fi
+# #ifndef fallbacks). Some of these are PRODUCT-CONDITIONAL (the authority cap is
+# 500e6 under PRODUCT_NAME_M17 / 800e6 otherwise, and the windup-gate tuning exists
+# only under PRODUCT_NAME_M17), so each target #define is emitted wrapped in its
+# exact enclosing preprocessor conditionals and the compiler resolves it per product
+# set -- a naive grep would emit BOTH authority-cap branches and clang only WARNS on
+# the redefinition, silently testing the wrong value.
+extract_defines() {  # $1 = source file, $2 = ERE matching the target #define lines
+    awk -v target="$2" '
+        /^[ \t]*#[ \t]*(if|ifdef|ifndef)([ \t(]|$)/ { depth++; open[depth] = $0; elseseen[depth] = 0; next }
+        /^[ \t]*#[ \t]*elif([ \t(]|$)/ { if (depth > 0) elseseen[depth] = 2; next }
+        /^[ \t]*#[ \t]*else/  { if (depth > 0) elseseen[depth] = 1; next }
+        /^[ \t]*#[ \t]*endif/ { if (depth > 0) depth--; next }
+        $0 ~ target {
+            for (i = 1; i <= depth; i++) if (elseseen[i] == 2) {
+                print "#error \"extract_defines: target define under #elif -- extend the extractor\""
+                exit
+            }
+            for (i = 1; i <= depth; i++) { print open[i]; if (elseseen[i]) print "#else" }
+            print
+            for (i = 1; i <= depth; i++) print "#endif"
+        }
+    ' "$1"
+}
