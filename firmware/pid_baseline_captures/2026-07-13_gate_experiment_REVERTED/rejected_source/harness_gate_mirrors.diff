+    fprintf(stderr, "release-fix coverage: stale crossings=%" PRIu64
+                    " (real-elapsed-counter=%" PRIu64 ") midpoint clamps=%" PRIu64
+                    " freeze-unwind steps=%" PRIu64 "\n",
+            g_stale_crossings, g_stale_elapsed, g_midpoint_clamps, g_unwind_steps);
+    fprintf(stderr, "slew coverage (fw 0.15.4.2): armed=%" PRIu64 " (rearm-in-flight=%" PRIu64
+                    " noarm-midpoint-eq=%" PRIu64 ") steps=%" PRIu64 " completed=%" PRIu64
+                    " passed=%" PRIu64 " abandoned=%" PRIu64 " parallel-unwind=%" PRIu64 "\n",
+            g_slew_armed, g_slew_rearm, g_slew_noarm, g_slew_steps,
+            g_slew_completed, g_slew_passed, g_slew_abandoned, g_slew_unwind);
+    if (!g_above_rail_ticks || !g_gate_crossings || !g_gate_open_ticks ||
+        !g_freeze_ticks || !g_hold_excess || !g_inward_above ||
+        !g_stale_crossings || !g_stale_elapsed || !g_midpoint_clamps || !g_unwind_steps) {
