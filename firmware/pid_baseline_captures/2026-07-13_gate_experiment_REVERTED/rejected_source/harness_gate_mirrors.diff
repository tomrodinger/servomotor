+    REQUIRE_5F_DELTA(g_slew_armed, s5f_armed, "(i) arm");
+    REQUIRE_5F_DELTA(g_midpoint_clamps, s5f_clamp, "(i) stale midpoint clamp");
+    REQUIRE_5F_DELTA(g_slew_steps, s5f_steps, "(i) partial step");
+    REQUIRE_5F_DELTA(g_slew_unwind, s5f_unw, "(i) parallel unwind");
+    tick(3000);    /* (ii) crossing with the slew IN FLIGHT: re-target to midpoint (17303360+98856960)/2=58080160,
+                    * dir=+1; same tick: step up to 23856960 (charging unwind not applied) */
+    REQUIRE_5F_DELTA(g_slew_rearm, s5f_rearm, "(ii) re-arm in flight");
+    for (int k = 0; k < 5; k++) tick(3000);   /* climb 6553600/tick: 30410560 ... 56624960 */
+    tick(3000);    /* (iii) remaining 1455200 < step: SNAP exactly onto 58080160, slew done */
+    REQUIRE_5F_DELTA(g_slew_completed, s5f_comp, "(iii) snap-complete");
+    for (int k = 0; k < 40; k++) tick(3000);  /* rest of freeze: recharging blocked, I holds */
+    tick(-3000);   /* (iv) crossing: midpoint (58080160+17303360)/2=37691760, dir=-1; same tick the parallel
+                    * unwind (-75000000) floors I at 0 after the partial step */
+    tick(-3000);   /* target 37691760 is now on the WRONG side of I=0 for dir=-1: reach-or-PASS, no snap-back */
+    REQUIRE_5F_DELTA(g_slew_passed, s5f_pass, "(iv) reach-or-pass");
+    for (int k = 0; k < 20; k++) tick(-3000); /* freeze continues at I=0 (nothing to unwind) */
+    tick(3000);    /* (v) crossing at I=0: midpoint (0+58080160)/2=29040080, dir=+1; steps to 6553600 */
+    for (int k = 0; k < GATE_HOLDOFF_DRV - 1; k++) tick(-999);  /* deadband stall: step up, floor to 0, every tick;
