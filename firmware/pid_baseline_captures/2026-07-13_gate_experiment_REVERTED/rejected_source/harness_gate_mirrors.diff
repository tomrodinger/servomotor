+                    " gate-open ticks=%" PRIu64 " freeze ticks=%" PRIu64
+                    " hold-excess ticks=%" PRIu64 " inward-above-limit ticks=%" PRIu64 "\n",
+            g_above_rail_ticks, g_gate_crossings, g_gate_open_ticks,
