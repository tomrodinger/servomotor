+    fprintf(stderr, "[phase 5f] crossing-slew walk...\n");
+    g_context = "slew-walk";
+    set_constants(2000, 25000, 0, 200);
+    reset_state();
+#ifdef PRODUCT_NAME_M17
+#define REQUIRE_5F_DELTA(counter, before, what) do { \
+        if ((counter) <= (before)) fail("5f sub-scenario did not fire: " what, (int64_t)(counter), (int64_t)(before)); \
+    } while (0)
+    uint64_t s5f_armed, s5f_rearm, s5f_noarm, s5f_steps, s5f_comp, s5f_pass, s5f_aband, s5f_unw, s5f_clamp;
